___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// YourCookieBanner for Google Tag Manager. Fire on "Consent Initialization - All Pages".
//
// 1. Every consent type starts denied, synchronously, before any other tag in the container fires.
// 2. The banner script loads. It alone decides which choice counts: a stored choice made under older settings, past
//    its lifetime, or for a category the site no longer uses is never passed on, and Global Privacy Control keeps
//    marketing off where it applies. So this template never reads the consent cookie itself.
// 3. Each choice that applies (also one made on an earlier visit) goes to GTM through updateConsentState, followed by
//    the cookiebanner_consent event. If the banner cannot load, everything stays denied.
const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const callInWindow = require('callInWindow');
const createQueue = require('createQueue');
const gtagSet = require('gtagSet');
const encodeUriComponent = require('encodeUriComponent');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const logToConsole = require('logToConsole');

const API = 'https://api.yourcookiebanner.com';

const state = function (granted) {
  return granted === true ? 'granted' : 'denied';
};

// An empty field is not "do not wait": as a number it would be 0, so it falls back to 500 like a missing one.
const wait = data.waitForUpdate === '' || data.waitForUpdate === undefined ? 500 : makeNumber(data.waitForUpdate);
setDefaultConsentState({
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: 'denied',
  functionality_storage: 'denied',
  personalization_storage: 'denied',
  security_storage: 'granted',
  wait_for_update: wait >= 0 ? wait : 500
});
if (data.adsDataRedaction) gtagSet('ads_data_redaction', true);
if (data.urlPassthrough) gtagSet('url_passthrough', true);

// Tells the banner that GTM owns Consent Mode: it then sends no consent commands or event of its own.
setInWindow('CookieBannerGtm', true, true);

const dataLayerPush = createQueue('dataLayer');

const onChoice = function (choices) {
  const c = choices || {};
  updateConsentState({
    ad_storage: state(c.marketing),
    ad_user_data: state(c.marketing),
    ad_personalization: state(c.marketing),
    analytics_storage: state(c.statistics),
    functionality_storage: state(c.preferences),
    personalization_storage: state(c.preferences),
    security_storage: 'granted'
  });
  // After the update, so tags triggered by this event already see the new consent state.
  dataLayerPush({
    event: 'cookiebanner_consent',
    cookiebanner: {
      necessary: true,
      preferences: c.preferences === true,
      statistics: c.statistics === true,
      marketing: c.marketing === true
    }
  });
};

const url = API + '/s/' + encodeUriComponent(makeString(data.siteId)) + '.js';
injectScript(
  url,
  function () {
    // The banner tells us the choice that applies now (if any) and every later one.
    callInWindow('CookieBanner.gtm', onChoice);
  },
  function () {
    logToConsole('YourCookieBanner: the banner script could not load, so consent stays denied.');
  },
  'yourcookiebanner'
);

data.gtmOnSuccess();


