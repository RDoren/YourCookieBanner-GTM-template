___TESTS___

scenarios:
- name: Denied defaults first, then the banner for this site
  code: |-
    let defaults;
    let injected;
    mock('setDefaultConsentState', (s) => { defaults = s; });
    mock('injectScript', (url, onSuccess, onFailure) => { injected = url; });
    runCode({ siteId: 'cb_7kq2m9xp4tna', waitForUpdate: 500, adsDataRedaction: true, urlPassthrough: false });
    assertThat(defaults.ad_storage).isEqualTo('denied');
    assertThat(defaults.ad_user_data).isEqualTo('denied');
    assertThat(defaults.ad_personalization).isEqualTo('denied');
    assertThat(defaults.analytics_storage).isEqualTo('denied');
    assertThat(defaults.functionality_storage).isEqualTo('denied');
    assertThat(defaults.personalization_storage).isEqualTo('denied');
    assertThat(defaults.wait_for_update).isEqualTo(500);
    assertThat(injected).isEqualTo('https://api.yourcookiebanner.com/s/cb_7kq2m9xp4tna.js');
    assertApi('gtagSet').wasCalledWith('ads_data_redaction', true);
    assertApi('gtmOnSuccess').wasCalled();
- name: The banner's choice goes to GTM's consent API, then the event
  code: |-
    let update;
    mock('injectScript', (url, onSuccess, onFailure) => { onSuccess(); });
    mock('callInWindow', (path, listener) => { listener({ necessary: true, preferences: false, statistics: true, marketing: false }); });
    mock('updateConsentState', (s) => { update = s; });
    runCode({ siteId: 'cb_7kq2m9xp4tna', waitForUpdate: 500 });
    assertApi('callInWindow').wasCalled();
    assertThat(update.analytics_storage).isEqualTo('granted');
    assertThat(update.ad_storage).isEqualTo('denied');
    assertThat(update.ad_user_data).isEqualTo('denied');
    assertThat(update.functionality_storage).isEqualTo('denied');
- name: If the banner cannot load, consent stays denied
  code: |-
    mock('injectScript', (url, onSuccess, onFailure) => { onFailure(); });
    runCode({ siteId: 'cb_7kq2m9xp4tna', waitForUpdate: 500 });
    assertApi('updateConsentState').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();


